// User -------------------------------------
model User {
    id        String @id @default(uuid()) @db.Uuid
    firstName String
    lastName  String
    email     String @unique
    password  String
    role      Role   @default(USER)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // RELATIONS ---------------------------------
    profile Profile?

    createdCategories Category[]
    createdPackages   TestPackage[]

    testAttempts TestAttempt[]
    userBadges   UserBadge[]
}

enum Role {
    SUPER_ADMIN
    ADMIN
    USER
}

// Profile -------------------------------------
model Profile {
    id  String  @id @default(uuid()) @db.Uuid
    bio String?
    exp Int     @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // RELATIONS ---------------------------------
    userId String @unique @db.Uuid
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Category -------------------------------------
model Category {
    id          String  @id @default(uuid()) @db.Uuid
    name        String  @unique
    description String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // RELATIONS ---------------------------------

    // Creator
    createdByUserId String @db.Uuid
    createdBy       User   @relation(fields: [createdByUserId], references: [id])

    // Packages belonging to this category
    testPackages TestPackage[]

    @@index([createdByUserId])
}

// Test Package -------------------------------------
model TestPackage {
    id               String  @id @default(uuid()) @db.Uuid
    title            String
    description      String?
    shortDescription String?

    durationMinutes   Int?
    passingPercentage Int  @default(70)
    expReward         Int  @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // RELATIONS ---------------------------------

    // Category
    categoryId String   @db.Uuid
    category   Category @relation(fields: [categoryId], references: [id])

    // Creator
    createdByUserId String @db.Uuid
    createdBy       User   @relation(fields: [createdByUserId], references: [id])

    // Questions
    questions TestPackageQuestion[]

    // User Attempts
    attempts TestAttempt[]

    @@unique([categoryId, title])
    @@index([createdByUserId])
    @@index([categoryId])
}

// Test Package <-> Question -------------------------
model TestPackageQuestion {
    position Int

    // RELATIONS ---------------------------------
    testPackageId String      @db.Uuid
    testPackage   TestPackage @relation(fields: [testPackageId], references: [id], onDelete: Cascade)

    questionId String       @db.Uuid
    question   TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

    @@id([testPackageId, questionId])
    // One question can only occupy one position
    // and two questions cannot share the same position.
    @@unique([testPackageId, position])
    @@index([questionId])
}

// Question ------------------------------------------
model TestQuestion {
    id          String       @id @default(uuid()) @db.Uuid
    title       String
    description String?
    type        QuestionType @default(MCQ_SINGLE)
    points      Int          @default(1)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // RELATIONS ---------------------------------

    // MCQ options
    mcqOptions McqOption[]

    // Packages containing this question
    testPackages TestPackageQuestion[]

    // Answers submitted for this question
    attemptAnswers TestAttemptAnswer[]
}

enum QuestionType {
    MCQ_SINGLE
    MCQ_MULTIPLE
    CODING
}

// MCQ Option ----------------------------------------
model McqOption {
    id        String  @id @default(uuid()) @db.Uuid
    text      String
    isCorrect Boolean @default(false)

    // RELATIONS ---------------------------------
    questionId String       @db.Uuid
    question   TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

    // Attempts where this option was selected
    selectedInAnswers TestAttemptAnswer[]

    @@index([questionId])
}

// Test Attempt --------------------------------------
model TestAttempt {
    id     String        @id @default(uuid()) @db.Uuid
    status AttemptStatus @default(IN_PROGRESS)

    score      Int?
    percentage Float?
    passed     Boolean?

    expAwarded Int @default(0)

    startedAt   DateTime  @default(now())
    completedAt DateTime?

    // RELATIONS ---------------------------------

    // User taking the test
    userId String @db.Uuid
    user   User   @relation(fields: [userId], references: [id])

    // Test being attempted
    testPackageId String      @db.Uuid
    testPackage   TestPackage @relation(fields: [testPackageId], references: [id])

    // User's answers
    answers TestAttemptAnswer[]

    @@index([userId])
    @@index([testPackageId])
    @@index([userId, testPackageId])
}

enum AttemptStatus {
    IN_PROGRESS
    COMPLETED
    ABANDONED
}

// Test Attempt Answer -------------------------------
model TestAttemptAnswer {
    id String @id @default(uuid()) @db.Uuid

    isCorrect     Boolean?
    pointsAwarded Int      @default(0)

    answeredAt DateTime @default(now())

    // RELATIONS ---------------------------------

    // Attempt this answer belongs to
    attemptId String      @db.Uuid
    attempt   TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

    // Question being answered
    questionId String       @db.Uuid
    question   TestQuestion @relation(fields: [questionId], references: [id])

    // Selected option for MCQ_SINGLE
    selectedOptionId String?    @db.Uuid
    selectedOption   McqOption? @relation(fields: [selectedOptionId], references: [id])

    // One answer per question in a particular attempt
    @@unique([attemptId, questionId])
    @@index([questionId])
    @@index([selectedOptionId])
}

// Badge ---------------------------------------------
model Badge {
    id          String  @id @default(uuid()) @db.Uuid
    name        String  @unique
    description String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // RELATIONS ---------------------------------
    userBadges UserBadge[]
}

// User <-> Badge ------------------------------------
model UserBadge {
    awardedAt DateTime @default(now())

    // RELATIONS ---------------------------------
    userId String @db.Uuid
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    badgeId String @db.Uuid
    badge   Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)

    @@id([userId, badgeId])
    @@index([badgeId])
}
